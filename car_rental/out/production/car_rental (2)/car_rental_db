//Here is mySQL code for the database
create if not exists database car_rental_db;

create table if not exists car_categories
(car_categories_id int auto_increment,
car_size varchar(254),
car_price varchar(254),
car_type varchar(254),
primary key (car_categories_id))
;
alter table car_categories
add constraint unique_category unique(car_size,car_price,car_type);

create table if not exists cars
(car_id int auto_increment,
category_id int,
car_model varchar(50),
cost_per_day double,
cubic_capacity int,
number_of_seats int,
primary key (car_id),
foreign key (category_id) references car_categories(car_categories_id) on delete cascade)
;

create table if not exists customers
(customer_id int auto_increment,
first_name varchar(254),
last_name varchar(254),
sex enum("male","female"),
address varchar(254),
email varchar(254),
phone varchar(20),
primary key (customer_id))
;

alter table customers
add constraint unique_customer unique(first_name,last_name,sex,address,email,phone);

create table if not exists rentals
(rental_id int auto_increment,
customer_id int,
car_id int,
days_of_rental int,
start_date date,
end_date date,
primary key (rental_id),
foreign key (customer_id) references customers(customer_id) on delete cascade,
foreign key (car_id) references cars(car_id) on delete cascade)
;
